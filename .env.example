# Get a free key at https://console.groq.com
LLM_API_KEY=

# Any OpenAI-compatible endpoint works. These are the defaults.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Retrieval tuning (rebuild with `docsage ingest` after changing chunking)
# TOP_K=5
# MIN_SIMILARITY=0.35
# CHUNK_WORDS=200
# CHUNK_OVERLAP=40
